# Copy to .env and fill in. Used by docker compose (and by the backend when run locally).
# Hosted PostgreSQL the backend connects to (tables are created by Alembic on startup).
# URL-encode special characters in the password (e.g. @ -> %40).
# From inside Docker, a Postgres on the host machine is host.docker.internal, not localhost.
DATABASE_URL=postgresql+psycopg://user:password@db.example.com:5432/stella

# Admin panel login at /admin
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-me
# Signs admin session cookies: python -c "import secrets; print(secrets.token_urlsafe(32))"
SECRET_KEY=change-me

# Ko-fi → Settings → API → Webhooks → Verification token
KOFI_VERIFICATION_TOKEN=
# Currency your Ko-fi page takes; payments in other currencies are logged as warnings
KOFI_CURRENCY=USD
# Origins allowed to call /api/supporters/* from the browser (comma-separated, * = any)
SUPPORTERS_CORS_ORIGINS=*
